# Copy this file to .env for local development. In production (Render, etc.)
# set these as environment variables in the dashboard instead of committing a .env file.

# Where the SQLite database file lives. Swap for a Postgres URL in production,
# e.g. postgresql+psycopg2://user:pass@host:5432/debate_scout
DATABASE_URL=sqlite:///./data/debate_scout.db

# Directory where uploaded tournament PDFs are temporarily stored.
UPLOAD_DIR=./data/uploads

# Optional: cap on concurrent opencaselist scrape jobs (per tournament run).
SCRAPE_CONCURRENCY=3
